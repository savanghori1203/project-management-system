<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Overdue Task Notification</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 600px;
            margin: 20px auto;
            background: #ffffff;
            padding: 20px;
            border-radius: 5px;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
        }

        .logo {
            text-align: center;
            margin-bottom: 20px;
        }

        .logo img {
            width: 120px;
        }

        .heading {
            font-size: 22px;
            font-weight: bold;
            color: #0F172A;
            text-align: center;
        }

        .message {
            font-size: 16px;
            color: #333;
            margin-top: 20px;
            line-height: 1.5;
        }

        .task-info {
            background: #f8d7da;
            padding: 10px;
            border-left: 4px solid #dc3545;
            margin: 20px 0;
            border-radius: 4px;
        }

        .task-info p {
            margin: 5px 0;
            font-weight: bold;
        }

        .btn {
            display: block;
            width: fit-content;
            margin: 20px auto;
            padding: 10px 20px;
            background: #dc3545;
            color: #fff;
            text-decoration: none;
            border-radius: 5px;
            text-align: center;
        }

        .footer {
            margin-top: 20px;
            font-size: 12px;
            text-align: center;
            color: #6B7280;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="logo">
            <img src="<%= logoURL %>" alt="<%= platformName %> Logo">
        </div>

        <div class="heading">Overdue Task Alert</div>

        <p class="message">
            Hello <%= userName %>,<br><br>
            You have an overdue task in the <strong><%= projectName %></strong> project. Please review and complete it as soon as possible.
        </p>

        <div class="task-info">
            <p>📌 Task: <%= taskTitle %></p>
            <p>⏳ Due Date: <%= dueDate %></p>
        </div>

        <a href="<%= taskURL %>" class="btn">View Task</a>

        <p class="footer">
            If you have any questions, please contact <a href="<%= supportURL %>">support</a>.
            <br>&copy; <%= platformName %>, All rights reserved.
        </p>
    </div>
</body>

</html>
